#!/bin/bash

# Report drift between the Omarchy files vendored into this plugin and the
# Omarchy shell installed on this machine.
#
# Read-only by design: it diffs and prints. It writes nothing, installs
# nothing and restarts nothing, so it is safe to run at any time.
#
# Usage: tools/upstream-diff [--names]

set -uo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
UPSTREAM="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/bar"
NAMES_ONLY=0
[[ ${1:-} == --names ]] && NAMES_ONLY=1

# Copied from the Omarchy bar unchanged. Any difference is an upstream change
# this plugin has not picked up yet.
VERBATIM=(
  BarModel.js
  indicators/Dnd.qml
  indicators/NightLight.qml
  indicators/ScreenRecording.qml
  indicators/StayAwake.qml
)

# Copied and then changed deliberately. Differences are expected here; the
# point is to read them and decide whether an upstream change needs porting.
ADAPTED=(
  Bar.qml
  indicators/Dictation.qml
  indicators/Reminder.qml
  widgets/TrayModel.js
)

# Rewritten from an upstream widget under a new name, one island per item.
# They drifted furthest, so they are the likeliest to miss a fix landing
# upstream, which is precisely why they are listed rather than called original.
DERIVED=(
  "widgets/IslandTray.qml:widgets/Tray.qml"
  "widgets/IslandWorkspaces.qml:widgets/Workspaces.qml"
  "widgets/IslandIndicators.qml:widgets/Indicators.qml"
)

[[ -d $UPSTREAM ]] || { echo "upstream bar not found: $UPSTREAM" >&2; exit 2; }

drift=0

report() {
  local file="$1" kind="$2" counterpart="${3:-$1}"
  local mine="$ROOT/$file" theirs="$UPSTREAM/$counterpart"

  if [[ ! -f $theirs ]]; then
    echo "[$kind] $file: gone from upstream"
    return
  fi

  cmp -s "$mine" "$theirs" && return

  echo "[$kind] $file differs from $counterpart"
  (( NAMES_ONLY )) || diff -u "$theirs" "$mine" | sed 's/^/    /'
}

for f in "${VERBATIM[@]}"; do
  before=$(report "$f" verbatim)
  [[ -n $before ]] && { echo "$before"; drift=1; }
done

for f in "${ADAPTED[@]}"; do
  out=$(report "$f" adapted)
  [[ -n $out ]] && echo "$out"
done

for pair in "${DERIVED[@]}"; do
  out=$(report "${pair%%:*}" derived "${pair##*:}")
  [[ -n $out ]] && echo "$out"
done

if (( drift )); then
  echo
  echo "Verbatim files drifted: upstream changed and this plugin has not rebased."
  exit 1
fi

echo "Verbatim files match ${UPSTREAM}."
